# --- Run the Agent in Jupyter ---
from google.adk.types import Event

# Wrap your prompt inside an ADK Event object
input_event = Event(text="What is the current time and weather in india?")

# Run the agent using the event
response = await healthy_hints_agent.run(input_event)
print(response.text)



