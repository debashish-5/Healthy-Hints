pip install google.adk.types


# --- Run the Agent in Jupyter ---
# Pass the input as a dictionary context to satisfy the positional argument check
# --- Run the Agent in Jupyter ---
from google.adk.runtime import Runtime

# Initialize the runtime with your agent
runtime = Runtime(agents=[healthy_hints_agent])

# Start the runtime session and send the message
session = await runtime.create_session(agent_name="healthy_hints_agent")
response = await session.send_message("What is the current time and weather in India?")

# Print the final answer from Gemini
print(response.text)



